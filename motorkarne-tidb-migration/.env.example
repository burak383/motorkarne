# TiDB Cloud "Connect" ekranından aldığın bilgileri buraya doldur.
# Bu dosyayı .env olarak kopyala (adını değiştir) ve gerçek değerleri gir.

TIDB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxxx.root
TIDB_PASSWORD=BURAYA_TIDB_SIFRENI_YAPISTIR
TIDB_DATABASE=motorkarne
