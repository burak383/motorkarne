TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=motorkarne
PORT=3000
ADMIN_API_KEY=

# Üyelik oturumları (JWT) için imzalama anahtarı. Uzun, rastgele bir dize olmalı —
# örn. terminalde `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# ile üretebilirsin. Bu değer sızarsa TÜM kullanıcı oturumları taklit edilebilir hale
# gelir, bu yüzden .env dışına asla yazma ve Railway'deki Variables bölümünden ayrıca gir.
JWT_SECRET=
