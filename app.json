{
  "expo": {
    "name": "MotorKarne",
    "slug": "motorkarne",
    "version": "1.0.0",
    "scheme": "motorkarne",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#11161C",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#11161C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.motorkarne.app"
    },
    "android": {
      "package": "com.motorkarne.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#11161C"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
